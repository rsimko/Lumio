{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lumio main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-focus",
    "core:webview:allow-set-webview-focus",
    "dialog:default",
    "log:default"
  ]
}
